{
  "manifest_version": 3,
  "name": "Pie Launcher",
  "description": "Lets Pie Launcher's Page Info read websites in Chrome, and offers your saved suggestions under fields.",
  "version": "1.1.0",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Pie Launcher",
    "default_popup": "popup.html"
  },
  "permissions": [
    "scripting",
    "storage",
    "alarms",
    "webNavigation",
    "debugger"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["suggest.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
